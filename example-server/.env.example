# Your GitHub App's ID (found on the app settings page)
APP_ID="12345"

# The webhook secret you configured when creating the app
WEBHOOK_SECRET="your-webhook-secret-here"

# Path to your app's private key .pem file
PRIVATE_KEY_PATH="./your-app-name.2026-06-10.private-key.pem"

# The namespace display name to register for this app installation.
# Rules: 1–15 characters, alphanumeric only (a–z, A–Z, 0–9), unique within the org.
# Property values are surfaced in GitHub as "<DISPLAY_NAME>.<property_name>", e.g. "acme.environment".
DISPLAY_NAME="acme"

# (Optional) How often to re-sync properties, in minutes. Default: 60
# Clamped to between 5 minutes and 10080 minutes (one week).
SYNC_INTERVAL_MINUTES="60"
